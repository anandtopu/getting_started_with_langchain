# Default provider. Change only this line to ollama after pulling local models.
LLM_PROVIDER=openai
# Optional explicit override; blank uses the selected provider profile below.
LLM_MODEL=
# auto chooses Ollama with local chat, OpenAI otherwise. Independent overrides supported.
EMBEDDINGS_PROVIDER=auto
# Optional embedding model override; changing it requires rebuilding vector indexes.
EMBEDDINGS_MODEL=
# Explicit offline fixtures for tests/smoke checks, never an automatic live fallback.
COURSE_OFFLINE=false
# Set this in the process environment (not only .env) to locate a non-editable checkout.
BRIGHTWAVE_ROOT=
# Optional runtime directory; relative paths resolve against the checkout.
RUNTIME_DIR=.runtime
# Call timeout in seconds, retry count, maximum output tokens, and sampling temperature.
MODEL_TIMEOUT=30
MODEL_MAX_RETRIES=2
MODEL_MAX_TOKENS=512
MODEL_TEMPERATURE=0
# Model identifiers verified 2026-10-28; profiles keep changing names out of code.
OPENAI_CHAT_MODEL=gpt-6-luna
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
GOOGLE_GENAI_CHAT_MODEL=gemini-3.5-flash-lite
OLLAMA_CHAT_MODEL=qwen3:4b
# Image lessons select this profile explicitly; text-only models cannot see images.
OLLAMA_VISION_MODEL=qwen3-vl:4b
# Embedding identifiers (Anthropic chat can use a separate embedding provider).
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
GOOGLE_GENAI_EMBEDDINGS_MODEL=gemini-embedding-001
OLLAMA_EMBEDDINGS_MODEL=embeddinggemma
# OpenAI Responses API and disabled reasoning make temperature=0 valid for this profile.
OPENAI_USE_RESPONSES_API=true
OPENAI_REASONING_EFFORT=none
# Change capability flags if overriding a model with different supported parameters.
OPENAI_TEMPERATURE_SUPPORTED=true
ANTHROPIC_TEMPERATURE_SUPPORTED=false
GOOGLE_GENAI_TEMPERATURE_SUPPORTED=true
# Local Ollama endpoint; the course never starts a server or downloads models silently.
OLLAMA_BASE_URL=http://localhost:11434
# Real keys belong only in .env or your process environment. Leave unused providers blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional web-search key; later lessons default to the offline research corpus.
TAVILY_API_KEY=
# Tracing is opt-in. Traces can contain prompts and synthetic customer data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=brightwave-course
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional deployment service; no Postgres needed for the foundation.
POSTGRES_URI=
# Standard uncached input/output USD per million tokens, verified 2026-10-28.
# These rates apply ONLY to the exact profile identified below; other models show unknown.
COST_MODEL=gpt-6-luna
COST_INPUT_PER_MILLION=0.10
COST_OUTPUT_PER_MILLION=0.50
# Teaching estimate; later budget middleware enforces call and token limits too.
MAX_RUN_COST_USD=0.05
# Local course API: generate two different random tokens (at least 32 characters).
# The customer token is bound to this one synthetic customer; manager token can review pauses.
# Leave blank until running the API. Do not use these static tokens as a public identity service.
API_CUSTOMER_TOKEN=
API_MANAGER_TOKEN=
API_CUSTOMER_ID=C001
API_BASE_URL=http://127.0.0.1:8000
API_REQUEST_TIMEOUT=45
